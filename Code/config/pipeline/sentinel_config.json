{
  "class_type": "Pipeline",
  "version": "1.0",
  "mermaid_path": "src/config/pipeline/mermaid",
  "default_input_shape": [1, 3, 224, 224],
  "audit_hooks": ["GRAPH_AUDIT", "PARAM_TRACE_HOOK", "NUMERICAL_STABILITY_HOOK", "HARDWARE_COMPLIANCE_HOOK"],
  "data": {
    "source": "data/sample.csv",
    "label_col": "target",
    "test_size": 0.2,
    "preprocessing": {
      "clean": true,
      "engineer": true,
      "scale": "StandardScaler"
    }
  },
  "model": {
    "name": "StandardDense",
    "overrides": {
      "in_features": 128,
      "out_features": 3
    }
  },
  "training": {
    "epochs": 50,
    "batch_size": 32,
    "loss": "CrossEntropyLoss",
    "optimizer": "adamw",
    "lr": 0.001
  }
}
