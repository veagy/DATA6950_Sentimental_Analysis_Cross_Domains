{
  "data": {
    "source": "data/train.csv",
    "label_col": "label",
    "test_size": 0.2,
    "preprocessing": {
      "clean": true,
      "engineer": false,
      "scale": null,
      "paradigm": "supervised"
    }
  },
  "model": {
    "name": "StandardDense",
    "overrides": { "in_features": 128, "out_features": 3 }
  },
  "training": {
    "epochs": 5,
    "batch_size": 32,
    "loss": "CrossEntropyLoss",
    "optimizer": "adamw",
    "lr": 0.001,
    "val_split": 0.2,
    "run_id": "minimal"
  }
}
